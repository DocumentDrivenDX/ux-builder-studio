{
  "id": "umf.app",
  "version": "0.1.0",
  "coreVersion": "0.10.0",
  "description": "An app as a catalog entry, at document scope: what it is for, its roles, the values it derives from its records, who may see which rows, how relationships map to fields, and the sample data a preview runs on. Presentation is umf.ux; behaviour is umf.actions.",
  "semantics": "App profile 0.1 (ux-builder studio). Roles are referenced by umf.actions role authorization and by umf.ux screens and navigation. Derived values are named, read-only values computed per row from umf.app.expr 1 expressions; they never persist. Access rules grant roles visibility of a record's rows, optionally narrowed by a row condition; a record with no access rules is visible to every role, a record with rules is visible only through them. Foreign keys name the field of a relationship's source record that holds the target's primary key. Samples are fabricated rows and identities for previews; they are never production data. Expressions are closed (no unknown operators, no code). Sources bind a record to an asset in the organisation's data catalog (catalog.schema.table): its rows are read and changed as the signed-in person, so the catalog's grants, row filters and column masks always apply, and the app's own access rules can only narrow them. A role may name organisation groups; a signed-in person has the roles whose groups they belong to.",
  "scopes": ["document"],
  "capabilities": {
    "validation": "semantic",
    "directions": [],
    "native": {
      "system": "ux-builder studio app definitions",
      "version": "0.1.0",
      "subset": "Document-scope app identity, roles, derived values, row access, foreign keys and fabricated samples for app profile 0.1; interpretation by the studio runtime"
    },
    "evidence": ["packages/app-definition/test/vocabularies.test.mjs"]
  },
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:umf:app:0.1.0",
    "title": "UMF app vocabulary 0.1.0",
    "type": "object",
    "required": ["name", "version", "roles"],
    "properties": {
      "kind": { "enum": ["reporting", "data-management", "own-data"], "description": "What the app is for: reporting on catalog data (read-only), managing catalog data (read and change), or its own data model." },
      "sources": { "type": "array", "maxItems": 64, "description": "Records whose rows live in the organisation's data catalog, read and written as the signed-in person under the catalog's own permissions. A record with a source has no table of its own and no samples.", "items": { "$ref": "#/$defs/source" } },
      "name": { "type": "string", "minLength": 1, "maxLength": 120 },
      "description": { "type": "string", "maxLength": 2000 },
      "useCase": { "type": "string", "maxLength": 2000 },
      "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
      "template": { "enum": ["tracker", "directory", "assistant", "request", "planner", "custom"] },
      "variantOf": {
        "type": "object",
        "required": ["id", "version"],
        "properties": { "id": { "$ref": "#/$defs/appId" }, "version": { "type": "string" }, "note": { "type": "string" } },
        "additionalProperties": false
      },
      "owner": { "type": "string" },
      "visibility": { "enum": ["private", "shared", "catalog"] },
      "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "maxItems": 32 },
      "roles": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/role" } },
      "identity": {
        "type": "object",
        "description": "How a signed-in person maps to a record (for user.* in expressions).",
        "required": ["record"],
        "properties": { "record": { "$ref": "#/$defs/ref" } },
        "additionalProperties": false
      },
      "derived": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/derived" } },
      "access": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/access" } },
      "foreignKeys": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/foreignKey" } },
      "fieldTypes": {
        "type": "object",
        "description": "Presentation types of core fields, by field element id: how a value is entered and shown (money, hours, email, long text…). UMF core keeps the scalar type.",
        "additionalProperties": { "enum": ["longtext", "email", "integer", "number", "money", "hours", "boolean", "date", "time", "datetime", "choice", "id"] }
      },
      "samples": { "$ref": "#/$defs/samples" }
    },
    "$defs": {
      "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
      "appId": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,63}$", "description": "An app's document id, as createApp makes them (e.g. app.time-tracker)" },
      "ref": {
        "type": "object",
        "required": ["module", "element"],
        "properties": { "module": { "type": "string", "minLength": 1 }, "element": { "type": "string", "minLength": 1 } },
        "additionalProperties": false
      },
      "rule": {
        "type": "object",
        "required": ["language", "version", "expression", "references"],
        "properties": {
          "language": { "const": "umf.app.expr" },
          "version": { "const": "1" },
          "expression": { "type": "string", "minLength": 1, "maxLength": 65536 },
          "references": { "type": "array", "maxItems": 128 }
        },
        "additionalProperties": false
      },
      "role": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "groups": { "type": "array", "description": "Organisation groups (from the studio's sign-in) whose members have this role in the app; \"*\" is everyone the app is shared with. A signed-in person has every role whose groups they belong to.", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true, "maxItems": 64 }
        },
        "additionalProperties": false
      },
      "source": {
        "type": "object",
        "required": ["id", "record", "asset", "access"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "record": { "$ref": "#/$defs/ref" },
          "asset": { "type": "string", "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$", "description": "The catalog asset's full name: catalog.schema.table." },
          "access": { "enum": ["read", "change"], "description": "What the app asks of the asset. change needs the catalog's MODIFY privilege for the person; the app can never widen what the catalog allows." },
          "limit": { "type": "integer", "minimum": 1, "maximum": 50000, "description": "The most rows read at a time (default 5000)." },
          "columns": { "type": "object", "description": "Field name to catalog column name, where they differ.", "additionalProperties": { "type": "string", "minLength": 1 } },
          "title": { "type": "string" },
          "description": { "type": "string" }
        },
        "additionalProperties": false
      },
      "derived": {
        "type": "object",
        "required": ["id", "record", "name", "scalarType", "expression"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "record": { "$ref": "#/$defs/ref" },
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "scalarType": { "enum": ["boolean", "integer", "decimal", "float", "string", "date", "time", "timestamp"] },
          "format": { "enum": ["text", "number", "currency", "hours", "date", "datetime", "time", "percent", "status"] },
          "expression": { "$ref": "#/$defs/rule" }
        },
        "additionalProperties": false
      },
      "access": {
        "type": "object",
        "required": ["id", "record", "roles"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "record": { "$ref": "#/$defs/ref" },
          "roles": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
          "when": { "$ref": "#/$defs/rule" },
          "description": { "type": "string" }
        },
        "additionalProperties": false
      },
      "foreignKey": {
        "type": "object",
        "required": ["relationship", "field"],
        "properties": { "relationship": { "type": "string", "minLength": 1 }, "field": { "$ref": "#/$defs/ref" } },
        "additionalProperties": false
      },
      "samples": {
        "type": "object",
        "properties": {
          "clock": { "type": "string", "description": "The fixed 'now' previews run at (ISO timestamp), so sample data stays meaningful." },
          "identities": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "required": ["id", "name", "roles"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "name": { "type": "string", "minLength": 1 },
                "email": { "type": "string" },
                "roles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "key": { "description": "The primary key of this person's identity record row." },
                "attributes": { "type": "object" },
                "note": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "records": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "object",
              "required": ["record", "rows"],
              "properties": {
                "record": { "$ref": "#/$defs/ref" },
                "rows": { "type": "array", "maxItems": 5000, "items": { "type": "object" } }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
