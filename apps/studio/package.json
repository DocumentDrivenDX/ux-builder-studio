{
  "name": "@ux-builder/studio",
  "version": "0.1.0",
  "private": true,
  "description": "UX Builder Studio: describe an app in plain language and an agent builds it as a UMF app definition (umf.app, umf.ux, umf.actions), rendered live with @ux-builder/ui and backed by Postgres tables UMF deploys. Runs entirely locally.",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-umf.mjs",
    "dev": "node scripts/dev.mjs",
    "server": "tsx server/main.ts",
    "web": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "oui": "oui generate",
    "oui:check": "oui generate --check",
    "test": "node --import tsx --test 'test/*.test.ts'",
    "e2e": "node scripts/user-test.mjs",
    "diagrams:docs": "node --import tsx scripts/doc-diagrams.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.102",
    "@ai-sdk/openai": "4.0.114",
    "@electric-sql/pglite": "0.5.16",
    "@ouispec/agent-core": "0.25.0",
    "@ouispec/agent-events": "0.25.0",
    "@ouispec/agent-react": "0.25.0",
    "@ouispec/agent-realtime": "0.25.0",
    "@ouispec/agent-worker": "0.25.2",
    "@ouispec/bindings": "0.12.3",
    "@ux-builder/app-definition": "*",
    "@ux-builder/app-runtime": "*",
    "@ux-builder/engine": "*",
    "@ux-builder/tokens": "*",
    "@ux-builder/ui": "*",
    "@ux-builder/visuals": "*",
    "ai": "7.0.169",
    "ajv": "^8.20.0",
    "express": "5.3.0",
    "oui-spec": "0.14.0",
    "pg": "^8.16.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@ouispec/cli": "0.13.0",
    "@ouispec/testing": "0.12.2",
    "@types/express": "5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.2"
  }
}
