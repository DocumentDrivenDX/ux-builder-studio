# Copy to .env (gitignored). Everything runs locally; only the AI model is remote.

# The agent's model. Set ONE key; without any, the studio uses its scripted
# builder (a fixed, recorded time-tracker build for tests and demos).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# STUDIO_MODEL=anthropic:claude-opus-5-5     # or openai:gpt-4.1, ollama:qwen2.5:14b, scripted

# Database: embedded PostgreSQL 18 (PGlite) in .data/pg by default.
# For a real Postgres: docker compose up -d   (see docker-compose.yml)
# DATABASE_URL=postgres://studio:studio@127.0.0.1:55432/studio

# Ports
# STUDIO_API_PORT=8787
# STUDIO_WEB_PORT=5173
# REDIS_PORT=6379
