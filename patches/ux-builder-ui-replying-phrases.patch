+/* What a reply in progress says: one phrase, or (strings.replying as a list)
+   a phrase from the list that changes every few seconds, never the same twice
+   running, with dots that pulse after it. Only the message shows the changing
+   phrase; the composer's status, which screen readers announce, keeps one. */
+const ROTATE_MS = 2600;
+const bare = (t) => String(t).replace(/(…|\.{3})\s*$/, "");
+function useReplyingPhrase(replying, active) {
+  const list = Array.isArray(replying) ? replying.filter(Boolean) : [replying];
+  const [i, setI] = useState(() => Math.floor(Math.random() * list.length));
+  useEffect(() => {
+    if (!active || list.length < 2) return;
+    const t = setInterval(() => setI((n) => (n + 1 + Math.floor(Math.random() * (list.length - 1))) % list.length), ROTATE_MS);
+    return () => clearInterval(t);
+  }, [active, list.length]);
+  return bare(list[i % list.length] ?? STRINGS.replying);
+}
+function ReplyingState({ phrase }) {
