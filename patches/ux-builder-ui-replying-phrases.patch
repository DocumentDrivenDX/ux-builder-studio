diff --git a/packages/ui/src/patterns.css b/packages/ui/src/patterns.css
index c42b041..d3423c8 100644
--- a/packages/ui/src/patterns.css
+++ b/packages/ui/src/patterns.css
@@ -960,6 +960,18 @@
 .piq-message__text { margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; }
 .piq-message__state { display: flex; align-items: center; gap: var(--piq-space-2); margin: 0; color: var(--piq-color-text-muted); font-size: var(--piq-font-size-small); }
 .piq-message__state[data-tone="error"] { color: var(--piq-color-text-strong); }
+/* A reply in progress: its phrase fades in as it changes, and three dots pulse after it. */
+.piq-message__state[data-state="replying"] { gap: 0; }
+.piq-message__phrase { animation: piq-phrase-in 240ms ease-out both; }
+.piq-message__dots { display: inline-flex; }
+.piq-message__dots > span { animation: piq-dot 1.2s ease-in-out infinite both; }
+.piq-message__dots > span:nth-child(2) { animation-delay: 160ms; }
+.piq-message__dots > span:nth-child(3) { animation-delay: 320ms; }
+@keyframes piq-dot { 0%, 80%, 100% { opacity: 0.2; } 40% { opacity: 1; } }
+@keyframes piq-phrase-in { from { opacity: 0; } to { opacity: 1; } }
+@media (prefers-reduced-motion: reduce) {
+  .piq-message__phrase, .piq-message__dots > span { animation: none; opacity: 1; }
+}
 .piq-message__error,
 .piq-message__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--piq-space-2); }
 
